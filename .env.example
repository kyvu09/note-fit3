# Sao chép file này thành ".env" và điền thông tin cá nhân của bạn trước khi chạy build-hap.ps1 / build-android-apk.ps1

# 1. Tên kênh đồng bộ bí mật của riêng bạn (chỉ dùng chữ cái, số, dấu gạch dưới)
SYNC_CHANNEL_PREFIX=f3n_change_me_secret_channel

# 2. Thông tin ký gói .hap cho Huawei Watch Fit 3 (đặt các file chứng chỉ vào thư mục signing/)
WATCH_KEYSTORE_FILE=signing/fit3notes.p12
WATCH_CERT_FILE=signing/your_debug_cert.cer
WATCH_PROFILE_FILE=signing/your_debug_profile.p7b
WATCH_KEY_ALIAS=fit3notes
WATCH_KEYSTORE_PASSWORD=CHANGE_ME_PASSWORD
WATCH_KEY_PASSWORD=CHANGE_ME_PASSWORD

# 3. Thông tin ký gói .apk cho Android Companion App (tự tạo keystore mới nếu chưa có)
ANDROID_KEYSTORE_FILE=signing/android-sender.jks
ANDROID_KEY_ALIAS=fit3sender
ANDROID_KEYSTORE_PASSWORD=CHANGE_ME_PASSWORD
ANDROID_KEY_PASSWORD=CHANGE_ME_PASSWORD
